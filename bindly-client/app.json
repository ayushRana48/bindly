{
  "expo": {
    "name": "bindly-client",
    "slug": "bindly-client",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": "com.airborm.bindly",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "venmo"
        ]
      }
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bindly",
              "host": "payment"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2fbbe1b1-62f4-47a4-91de-b96b0020b8fe"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}